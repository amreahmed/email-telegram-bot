# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
# Comma-separated Telegram chat IDs that receive copies of incoming/outgoing audit traffic:
BOT_AUDIT_CHAT_IDS=

# Server Configuration
PORT=3000
SESSION_SECRET=replace_with_a_long_random_secret
TOKEN_ENCRYPTION_SALT=replace_with_a_random_salt_value

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/outlook_telegram_bot

# Microsoft Azure OAuth & Graph API
MS_CLIENT_ID=your_azure_app_client_id
MS_CLIENT_SECRET=your_azure_app_client_secret
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
ALLOWED_MAIL_DOMAINS=

# Polling & Synchronization
POLL_INTERVAL_SECONDS=45
FETCH_OVERLAP_SECONDS=45
ACCOUNT_PROCESS_CONCURRENCY=5
GRAPH_PAGE_SIZE=50
GRAPH_MAX_PAGES=10
GRAPH_REQUEST_MAX_RETRIES=4
MAX_CONSECUTIVE_FAILURES=5
DEBUG_MAIL_CHECKS=false

# Provider Rules & Code Extraction
OTP_PROVIDER_DOMAINS=webook.com,webhook.com,webhook.site
SHARED_SCOPE_MODE=all
SHARED_ALLOWED_TELEGRAM_IDS=
NOTIFICATION_GROUP_CHAT_IDS=
# Optional JSON array to override/add custom providers:
# PROVIDER_RULES_JSON=[{"name":"Webook","key":"webook","priority":100,"strict":true,"senderDomain":["webook.com"],"subjectContains":["verification","code"],"bodyContains":["verification","code"],"codeRegex":"\\b\\d{4,8}\\b"}]

# Ticket Reporting & Export Service
TICKET_REPORT_PAGE_SIZE=100
TICKET_REPORT_MAX_PAGES=20
TICKET_REPORT_ACCOUNT_CONCURRENCY=6
